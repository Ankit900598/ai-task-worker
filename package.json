{
  "name": "ai-task-worker",
  "version": "1.0.0",
  "description": "Auditable Autonomous AI Task Worker with Policy Approval Gate, Verification Guard, and Ledgerly Evaluation Suite",
  "type": "module",
  "main": "automation_engine.js",
  "scripts": {
    "start": "node automation_engine.js",
    "start:azure": "node automation_engine.js --provider=azure",
    "start:bedrock": "node automation_engine.js --provider=bedrock",
    "test": "node --test test_engine.js test/ledgerly.test.js",
    "test:apis": "node test_apis.js",
    "test:ledgerly": "node --test test/ledgerly.test.js",
    "evals": "node evals/runner.js",
    "evals:3x": "node evals/runner.js --runs=3",
    "test:mutation": "node test/mutation_test.js",
    "test:heldout": "node evals/heldout_runner.js",
    "ledgerly": "node ledgerly/server.js",
    "ui": "node ui/server.js"
  },
  "keywords": [
    "playwright",
    "openai",
    "bedrock",
    "ai-agent",
    "web-automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "dotenv": "^18.0.8",
    "openai": "^7.39.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1"
  }
}
